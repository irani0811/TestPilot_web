# Optional: enable an OpenAI-compatible LLM endpoint.
# ChatECNU documentation: https://developer.ecnu.edu.cn/vitepress/llm/model.html
# Leave the key blank to run fully offline with the built-in rule engine.
LLM_API_URL=https://chat.ecnu.edu.cn/open/api/v1
LLM_API_KEY=
LLM_MODEL=ecnu-plus
SECRET_KEY=change-me-in-production
DATABASE_PATH=data/testpilot.db
MAX_CONTENT_LENGTH=2097152
